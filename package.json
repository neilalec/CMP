{
  "name": "cmp-dev-workspace",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "dev:docker": "docker compose up --build",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:wardogs": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -DevelopmentTarget wardogs",
    "dev:squad": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -DevelopmentTarget squad",
    "dev:down": "docker compose down"
  }
}
