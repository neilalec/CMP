{
  "server": {
    "id": 1,
    "host": "YOUR_OASIS_SERVER_IP",
    "queryPort": 27165,
    "rconPort": 21114,
    "rconPassword": "YOUR_RCON_PASSWORD",
    "disableLogParser": false,
    "logReaderMode": "sftp",
    "logDir": "/path/to/SquadGame/Saved/Logs",
    "ftp": {
      "host": "YOUR_OASIS_SERVER_IP",
      "port": 21,
      "user": "YOUR_FTP_USERNAME",
      "password": "YOUR_FTP_PASSWORD"
    },
    "sftp": {
      "host": "YOUR_OASIS_SERVER_IP",
      "port": 22,
      "username": "YOUR_SFTP_USERNAME",
      "password": "YOUR_SFTP_PASSWORD"
    },
    "adminLists": []
  },
  "connectors": {},
  "plugins": [
    {
      "plugin": "CmpBridge",
      "enabled": true,
      "host": "0.0.0.0",
      "port": 3001,
      "token": "replace-with-a-local-bridge-token"
    },
    {
      "plugin": "CmpLayerTest",
      "enabled": true,
      "changeCommand": "cmpchange",
      "nextCommand": "cmpnext"
    }
  ],
  "logger": {
    "verboseness": {
      "SquadServer": 2,
      "LogParser": 1,
      "RCON": 2
    },
    "colors": {
      "SquadServer": "yellowBright",
      "SquadServerFactory": "yellowBright",
      "LogParser": "blueBright",
      "RCON": "redBright"
    }
  }
}
